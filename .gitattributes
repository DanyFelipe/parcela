# Normalize line endings to LF for every text file, on every OS.
# Prevents Windows core.autocrlf from materializing CRLF files locally,
# which breaks `prettier --check` (project enforces LF).
* text=auto eol=lf

# Binary files are never touched by text normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary